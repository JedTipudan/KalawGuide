# KalawGuide — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Required for real Google Sign-In. Without this, the app uses demo mode.

EXPO_PUBLIC_GOOGLE_CLIENT_ID=<your-google-web-client-id>
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<your-google-android-client-id>
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<your-google-ios-client-id>

# ─── Backend API (optional — app works offline without this) ─────────────────
# If you add a remote backend, set the base URL here.

EXPO_PUBLIC_API_BASE_URL=https://api.kalawguide.app

# ─── App Configuration ───────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
