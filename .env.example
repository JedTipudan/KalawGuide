# KalawGuide — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Everything here is OPTIONAL. With no .env at all the app runs fully:
#   • The live map needs NO API key (Leaflet + free Esri / OpenStreetMap tiles + phone GPS).
#   • Kalaw Assistance needs NO API key (it runs offline on the device).
#   • Without the Turso settings below, data lives in SQLite on each device/browser (offline).
#
# EXPO_PUBLIC_* values are baked into the app at build time and are visible to anyone,
# so never put a secret in them.

# ─── Google Sign-In (optional) ───────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Leave blank to keep "Continue with Google" in demo mode.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ─── Shared online database (needed for multi-device testing) ───────────────
# Turso (hosted SQLite, free plan, no credit card). With these set, every phone, the APK and the
# website use ONE database: a business approved by the admin on one device shows for tourists on all.
# Setup: guide.html → "Shared online database". Leave blank to keep data on each device.
EXPO_PUBLIC_TURSO_DATABASE_URL=
EXPO_PUBLIC_TURSO_AUTH_TOKEN=

# ─── Real map (recommended) ──────────────────────────────────────────────────
# A real vector map with satellite and 3D. Step-by-step setup: guide.html → "Real map with a free API key".
# MapTiler: free plan, no credit card → https://cloud.maptiler.com/account/keys/
EXPO_PUBLIC_MAPTILER_KEY=
# Google Maps JavaScript API (needs a Google Cloud billing account; monthly free usage cap)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# Optional: force one when several keys are set: maptiler | google | free
EXPO_PUBLIC_MAP_PROVIDER=
#
# With no key, or a wrong one, the app automatically uses the keyless map below.

# ─── Keyless map style (optional) ────────────────────────────────────────────
# Leave blank: the keyless map uses Esri street tiles (OpenStreetMap as backup).
# Only if you prefer CARTO's look: get a FREE key (no account) at https://carto.com/basemaps/apikey
# Without a key CARTO shows an "API KEY REQUIRED" watermark, which is why it's no longer the default.
EXPO_PUBLIC_CARTO_KEY=

# ─── App Configuration ───────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=production
